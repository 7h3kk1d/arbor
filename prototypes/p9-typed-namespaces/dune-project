(lang dune 3.17)

(using menhir 3.0)

(name p9_typed_namespaces)

(generate_opam_files true)

(package
 (name p9_typed_namespaces)
 (synopsis "Phase 9 prototype: a single typed language with hierarchical names, error-recovering parsing, and a browser UI")
 (description
  "Fuses three earlier prototypes. From p6-stlc: bidirectional type-checking at ingest with the type-of aspect. From p8-holes: total parser, error-recovery via menhir's incremental API, bare-payload Hole nodes with a constant hash. From p7-web-interface: js_of_ocaml + Bonsai in-browser UI. The language is a single typed surface — no lc/stlc pair — with let bindings, pairs, native Int/Bool/String, and primitive arithmetic/boolean/string-concat operations. Names are hierarchical dot-paths (math.add) with Unison-style longest-suffix resolution. The type-checker is permissive about holes: a term with holes can still cache a best-guess type under a Type_with_holes(Ty.t) aspect; outright mismatches still reject ingest. A has-holes-transitively aspect caches whether a term (or any of its DAG descendants) contains a hole. The UI surfaces a recovered-AST panel that re-renders the post-recovery surface AST every keystroke.")
 (depends
  (ocaml (>= 5.2))
  (reason (>= 3.12))
  menhir
  menhirLib
  ppx_deriving
  (digestif (>= 1.1))
  (js_of_ocaml (>= 5.6.0))
  (js_of_ocaml-ppx (>= 5.6.0))
  (bonsai (and (>= v0.17) (< v0.18)))
  (virtual_dom (and (>= v0.17) (< v0.18)))
  (core (and (>= v0.17) (< v0.18)))
  (ppx_jane (and (>= v0.17) (< v0.18)))
  (alcotest :with-test)
  (qcheck :with-test)
  (qcheck-alcotest :with-test)))
