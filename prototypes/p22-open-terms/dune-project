(lang dune 3.17)

(using menhir 3.0)

(name p22_open_terms)

(generate_opam_files true)

(package
 (name p22_open_terms)
 (synopsis "Phase 22 prototype: open terms and explicit links")
 (description
  "Open terms with their free variables abstracted into a telescope, and links as separate stored objects, so binding is a recorded transformation rather than a collapse. Propagation rewrites link vectors; recursive groups close the cycle in the link rather than in the hasher or the object language. Three histories — author edits, dependency movement, renames — derive from one operation log.")
 (depends
  (ocaml (>= 5.2))
  (reason (>= 3.12))
  menhir
  menhirLib
  ppx_deriving
  (digestif (>= 1.1))
  (js_of_ocaml (>= 5.6.0))
  (js_of_ocaml-ppx (>= 5.6.0))
  (bonsai (and (>= v0.17) (< v0.18)))
  (virtual_dom (and (>= v0.17) (< v0.18)))
  (core (and (>= v0.17) (< v0.18)))
  (ppx_jane (and (>= v0.17) (< v0.18)))
  (alcotest :with-test)
  (qcheck :with-test)
  (qcheck-alcotest :with-test)))
