(lang dune 3.17)

(using menhir 3.0)

(name p21_unison_model)

(generate_opam_files true)

(package
 (name p21_unison_model)
 (synopsis "Phase 21 prototype: Unison's model on a small typed language")
 (description
  "An executable counterpart to the mini-unison formalization. Component hashing over strongly connected components, references as (hash, position) pairs, the type inside the term hash, a namespace that is a relation, a watch cache, and update-by-render-and-reparse with evict-on-failure. The scratch buffer holds several definitions with their name bindings.")
 (depends
  (ocaml (>= 5.2))
  (reason (>= 3.12))
  menhir
  menhirLib
  ppx_deriving
  (digestif (>= 1.1))
  (js_of_ocaml (>= 5.6.0))
  (js_of_ocaml-ppx (>= 5.6.0))
  (bonsai (and (>= v0.17) (< v0.18)))
  (virtual_dom (and (>= v0.17) (< v0.18)))
  (core (and (>= v0.17) (< v0.18)))
  (ppx_jane (and (>= v0.17) (< v0.18)))
  (alcotest :with-test)
  (qcheck :with-test)
  (qcheck-alcotest :with-test)))
