(lang dune 3.16)

(using menhir 3.0)

(name p5_multi_language)

(generate_opam_files true)

(package
 (name p5_multi_language)
 (synopsis "Phase 5 prototype: multi-language substrate with arith→lc translation")
 (description
  "Carries p3's untyped arithmetic and p4's untyped lambda calculus together in a single content-addressed Store keyed by a Definition.t sum. Adds a hand-written Church-encoding translator from arithmetic to lambda calculus, invoked manually from the REPL and cached as a derived aspect on the source. Validates the substrate's multi-language claim and the translator-as-derived-procedure design from docs/design/05-translation.md.")
 (depends
  (ocaml (>= 5.2))
  (reason (>= 3.12))
  menhir
  ppx_deriving
  digestif
  (alcotest :with-test)
  (qcheck :with-test)
  (qcheck-alcotest :with-test)))
