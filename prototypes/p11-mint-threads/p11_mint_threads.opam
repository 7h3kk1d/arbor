# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Phase 11 prototype: mint threads, binding history, and update strategies"
description:
  "Forks p10 to exercise three new substrate ideas: mint threads (an explicit edit-of-X gesture preserves a mint mark across content edits, producing a thread of versioned hashes), append-only binding history per namespace name (with orphan rendering as `name(vN)`), and update strategies as substrate operations (Pin / Follow / Explicit migrate) built on three primitives — reverse-DAG callers query, atomic multi-rebind, and a follow-clean derived aspect with a type-preserving short-circuit. Carries p10's mint-by-default substrate, label sort, records, tuples, lists, and Bonsai+jsoo three-pane UI; hash space is incompatible with p10 (language tag byte 'R')."
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2"}
  "reason" {>= "3.12"}
  "menhir"
  "menhirLib"
  "ppx_deriving"
  "digestif" {>= "1.1"}
  "js_of_ocaml" {>= "5.6.0"}
  "js_of_ocaml-ppx" {>= "5.6.0"}
  "bonsai" {>= "v0.17" & < "v0.18"}
  "virtual_dom" {>= "v0.17" & < "v0.18"}
  "core" {>= "v0.17" & < "v0.18"}
  "ppx_jane" {>= "v0.17" & < "v0.18"}
  "alcotest" {with-test}
  "qcheck" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
