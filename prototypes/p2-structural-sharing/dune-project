(lang dune 3.16)

(using menhir 3.0)

(name p2_structural_sharing)

(generate_opam_files true)

(package
 (name p2_structural_sharing)
 (synopsis "Phase 2 prototype: content-addressed DAG storage with eval-cache aspect")
