(lang dune 3.17)

(using menhir 3.0)

(name p10_minted_labels)

(generate_opam_files true)

(package
 (name p10_minted_labels)
 (synopsis "Phase 10 prototype: minted identity, label sort, records/tuples/lists, Unison-ish surface syntax")
 (description
  "Forks p9 to exercise two new substrate ideas: minted identity (every Term/Type/Label definition mints a fresh mark on creation; no structural-by-default escape hatch) and the label sort (Definition.t = Term | Type | Label; record types reference labels by hash, so field-name renames leave record-type hashes untouched). Adds tuples (n-ary positional), records (labeled, riding the label sort), and monomorphic lists with literal syntax and primitive-registry operations. Reuses p9's typed namespace, primitive registry, parser-recovery driver, and Bonsai+jsoo three-pane UI; rewrites the parser around a Unison-ish surface syntax with light layout sensitivity and Capitalized-vs-lowercase disambiguation between namespaces/types and terms/labels. Hash space is incompatible with p9 (language tag byte 'Q').")
 (depends
  (ocaml (>= 5.2))
  (reason (>= 3.12))
  menhir
  menhirLib
  ppx_deriving
  (digestif (>= 1.1))
  (js_of_ocaml (>= 5.6.0))
  (js_of_ocaml-ppx (>= 5.6.0))
  (bonsai (and (>= v0.17) (< v0.18)))
  (virtual_dom (and (>= v0.17) (< v0.18)))
  (core (and (>= v0.17) (< v0.18)))
  (ppx_jane (and (>= v0.17) (< v0.18)))
  (alcotest :with-test)
  (qcheck :with-test)
  (qcheck-alcotest :with-test)))
